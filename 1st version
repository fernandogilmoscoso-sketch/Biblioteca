  const wsData  = XLSX.utils.aoa_to_sheet([headers, example]);
  wsData['!cols'] = [
    {wch:32},{wch:26},{wch:9},{wch:8},{wch:9},{wch:14},{wch:22},{wch:7},
    {wch:15},{wch:10},{wch:9},{wch:17},{wch:13},{wch:30},{wch:20}
  ];
  XLSX.utils.book_append_sheet(wb, wsData, 'Libros');

  // Hoja 2: Instrucciones
  const instrRows = [
    ['INSTRUCCIONES DE USO — Plantilla Mi Biblioteca'],
    [''],
    ['Campo','Obligatorio','Descripción','Valores aceptados'],
    ...FIELD_DOCS.map(f => [f.field, f.req?'SÍ':'No', f.desc, f.vals]),
    [''],
    ['SECCIONES DISPONIBLES','','',''],
    ...getAllSections().map(s => [s.code, s.name,'','']),
    [''],
    ['NOTAS IMPORTANTES','','',''],
    ['• Campos OBLIGATORIOS: Titulo, Autor, Estante, Posicion y Fecha ingreso. Las filas sin estos datos serán ignoradas.','','',''],
    ['• La columna Seccion acepta: código (NC), nombre completo (Novela Colombiana) o código+nombre (NC - Novela Colombiana). No es obligatoria pero sí muy recomendada.','','',''],
    ['• Si Seccion no se reconoce, el libro se asignará automáticamente a OT (Otros).','','',''],
    ['• El sistema acepta encabezados en español e inglés, con o sin tildes.','','',''],
    ['• Guarda el archivo como .xlsx o .csv antes de importarlo.','','',''],
  ];
  const wsInstr = XLSX.utils.aoa_to_sheet(instrRows);
  wsInstr['!cols'] = [{wch:20},{wch:12},{wch:38},{wch:55}];
  XLSX.utils.book_append_sheet(wb, wsInstr, 'Instrucciones');

  XLSX.writeFile(wb, 'plantilla-mi-biblioteca.xlsx');
  toast('Plantilla descargada. Ábrela en Excel, llena los datos y luego impórtala aquí.');
}

