    if (el) el.addEventListener('change', updateLoc);
    if (el) el.addEventListener('input', updateLoc);
  });

  // ISBN field sync
  const isbnInput = document.getElementById('isbn-input');
  const fIsbn = document.getElementById('f-isbn');
  if (isbnInput && fIsbn) {
    isbnInput.addEventListener('input', () => { fIsbn.value = isbnInput.value; });
  }

  // Photo upload
  const photoInput = document.getElementById('photo-input');
  if (photoInput) {
    photoInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const compressed = await compressImage(file);
      const area = document.getElementById('photo-area');
      if (area) {
        area.innerHTML = `<img src="${compressed}" class="photo-preview" id="photo-preview"><div style="font-size:11px;color:var(--text-muted)">Haz clic para cambiar</div>`;
      }
      window._pendingPhoto = compressed;
    });
  }
}

async function doISBNLookup() {
  const isbn = val('isbn-input').replace(/[-\s]/g,'');
  if (!isbn) return;
  const st = document.getElementById('isbn-status');
  if (st) { st.className = 'isbn-status loading'; st.textContent = 'Consultando Google Books…'; }
  try {
    const res = await fetch(`https://www.googleapis.com/books/v1/volumes?q=isbn:${isbn}&maxResults=1`);
    const data = await res.json();
    if (!data.totalItems || !data.items?.length) throw new Error('ISBN no encontrado en la base de datos');
    const info = data.items[0].volumeInfo;
    const authors = (info.authors||[]).join('; ');
    const year = info.publishedDate?.slice(0,4) || '';
    // Populate form fields
    setVal('f-title', info.title||'');
    setVal('f-author', authors);
    setVal('f-publisher', info.publisher||'');
    setVal('f-year', year);
    setVal('f-pages', info.pageCount||'');
    setVal('f-isbn', isbn);
    setVal('isbn-input', isbn);
    // Try to set language
    if (info.language === 'es') setSelectVal('f-lang', 'Español');
    if (info.language === 'en') setSelectVal('f-lang', 'Inglés');
    if (info.language === 'fr') setSelectVal('f-lang', 'Francés');
    if (info.language === 'pt') setSelectVal('f-lang', 'Portugués');
    if (info.language === 'de') setSelectVal('f-lang', 'Alemán');
    // Cover image
    const imgUrl = info.imageLinks?.thumbnail || info.imageLinks?.smallThumbnail;
    if (imgUrl) {
      try {
        const resp = await fetch(imgUrl);
        const blob = await resp.blob();
        const reader = new FileReader();
        reader.onload = () => {
          window._pendingPhoto = reader.result;
          const area = document.getElementById('photo-area');
          if (area) area.innerHTML = `<img src="${reader.result}" class="photo-preview"><div style="font-size:11px;color:var(--text-muted)">Haz clic para cambiar</div>`;
        };
        reader.readAsDataURL(blob);
      } catch {}
    }
    if (st) { st.className = 'isbn-status ok'; st.textContent = '✓ Datos encontrados y completados automáticamente.'; }
  } catch (e) {
    if (st) { st.className = 'isbn-status err'; st.textContent = '✗ ' + e.message; }
  }
}

function val(id) { const el = document.getElementById(id); return el ? el.value.trim() : ''; }
function setVal(id, v) { const el = document.getElementById(id); if (el) el.value = v; }
function setSelectVal(id, v) {
  const el = document.getElementById(id);
  if (!el) return;
  for (const opt of el.options) if (opt.value === v) { opt.selected = true; break; }
}

async function compressImage(file) {
  return new Promise(resolve => {
    const reader = new FileReader();
    reader.onload = e => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const ratio = Math.min(120/img.width, 180/img.height, 1);
        canvas.width = img.width * ratio; canvas.height = img.height * ratio;
        canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
        resolve(canvas.toDataURL('image/jpeg', 0.6));
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  });
}

function saveBook() {
  const title   = val('f-title');
  const author  = val('f-author');
  const section = val('f-section');
  if (!title) { toast('El título es obligatorio.'); return; }
  if (!author) { toast('El autor es obligatorio.'); return; }
  if (!section) { toast('Selecciona una sección de localización.'); return; }

  const shelf = parseInt(val('f-shelf')) || '';
  const pos   = parseInt(val('f-pos')) || '';
  const lc    = locCode(section, shelf, pos);

  const data = {
    title, author, section, shelf, position:pos, locationCode:lc,
    coauthors: val('f-coauthors'),
    publisher: val('f-publisher'),
    year:      val('f-year'),
    isbn:      val('f-isbn') || val('isbn-input'),
    language:  val('f-lang'),
    pages:     val('f-pages'),
    coverType:       val('f-cover'),
    condition:       val('f-cond'),
    acquisitionDate: val('f-acq-date'),
    notes:           val('f-notes'),
    coverImage: window._pendingPhoto || (state.editId ? (DB.books().find(b=>b.id===state.editId)?.coverImage||'') : ''),
  };

  if (state.editId) {
    DB.updateBook(state.editId, data);
    toast('Libro actualizado correctamente.');
  } else {
    DB.addBook(data);
    toast('Libro registrado correctamente.');
  }
  window._pendingPhoto = null;
  state.editId = null;
  navigate('catalog');
}

