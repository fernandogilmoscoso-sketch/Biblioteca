function exportXLSX() {
  const books = DB.books();
  if (!books.length) { toast('No hay libros para exportar.'); return; }

  if (typeof XLSX === 'undefined') {
    toast('SheetJS no cargó. Exportando como CSV…'); exportCSV(); return;
  }

  const wb = XLSX.utils.book_new();

  // ── Hoja 1: Catálogo completo ──────────────────────────────────────────────
  const headers = [
    'Ubicación','Título','Autor','Coautores','Sección','Nombre sección',
    'Estante','Posición','Editorial','Año publicación','ISBN','Idioma',
    'Páginas','Encuadernación','Estado','Fecha ingreso','Notas'
  ];
  const dataRows = books.map(b => {
    const s = sec(b.section);
    return [
      b.locationCode||'',
      b.title||'',
      b.author||'',
      b.coauthors||'',
      b.section||'',
      s.name||'',
      b.shelf||'',
      b.position||'',
      b.publisher||'',
      b.year||'',
      b.isbn||'',
      b.language||'',
      b.pages ? Number(b.pages)||b.pages : '',
      b.coverType||'',
      b.condition||'',
      b.acquisitionDate||'',
      b.notes||''
    ];
  });

  const wsCat = XLSX.utils.aoa_to_sheet([headers, ...dataRows]);
  wsCat['!cols'] = [
    {wch:12},{wch:36},{wch:26},{wch:20},{wch:7},{wch:22},
    {wch:8},{wch:9},{wch:22},{wch:7},{wch:15},{wch:10},
    {wch:8},{wch:15},{wch:13},{wch:13},{wch:30}
  ];
  // Estilos de encabezado (si el motor los soporta)
  if (wsCat['A1']) {
    headers.forEach((_, i) => {
      const cell = wsCat[XLSX.utils.encode_cell({r:0, c:i})];
      if (cell) cell.s = { font:{bold:true}, fill:{fgColor:{rgb:'1E3A5F'}}, font:{color:{rgb:'FFFFFF'},bold:true} };
    });
  }
  XLSX.utils.book_append_sheet(wb, wsCat, 'Catálogo');

  // ── Hoja 2: Por sección ────────────────────────────────────────────────────
  const bySection = {};
  books.forEach(b => { bySection[b.section] = (bySection[b.section]||0)+1; });
  const secRows = getAllSections()
    .filter(s => bySection[s.code])
    .sort((a,b) => (bySection[b.code]||0)-(bySection[a.code]||0))
    .map(s => [s.code, s.name, bySection[s.code]||0]);
  const wsSec = XLSX.utils.aoa_to_sheet([
    ['Código','Sección','Total libros'],
    ...secRows,
    [],
    ['','TOTAL', books.length]
  ]);
  wsSec['!cols'] = [{wch:8},{wch:28},{wch:12}];
  XLSX.utils.book_append_sheet(wb, wsSec, 'Por sección');

  // ── Hoja 3: Préstamos activos ─────────────────────────────────────────────
  const loans = DB.loans().filter(l => l.status === 'active');
  if (loans.length) {
    const lHeaders = ['Título','Autor','Ubicación','Prestatario','Teléfono','Fecha préstamo','Devolución esperada','Notas'];
    const lRows = loans.map(l => {
      const b = DB.books().find(x => x.id === l.bookId) || {};
      return [
        b.title||'', b.author||'', b.locationCode||'',
        l.borrowerName||'', l.borrowerPhone||'',
        l.dateOut||'', l.expectedReturn||'', l.notes||''
      ];
    });
    const wsLoans = XLSX.utils.aoa_to_sheet([lHeaders, ...lRows]);
    wsLoans['!cols'] = [{wch:32},{wch:24},{wch:12},{wch:20},{wch:13},{wch:13},{wch:13},{wch:28}];
    XLSX.utils.book_append_sheet(wb, wsLoans, 'Préstamos activos');
  }

  const fecha = new Date().toISOString().slice(0,10);
  XLSX.writeFile(wb, `biblioteca-${fecha}.xlsx`);
  toast(`✓ Catálogo exportado: ${books.length} libros en biblioteca-${fecha}.xlsx`);
}

