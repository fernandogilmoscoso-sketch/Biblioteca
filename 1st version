function exportCSV() {
  const books = DB.books();
  if (!books.length) { toast('No hay libros para exportar.'); return; }
  const cols = ['Ubicación','Título','Autor','Sección','Nombre Sección','Editorial','Año publicación','ISBN','Idioma','Páginas','Encuadernación','Estado','Fecha ingreso','Fecha registro sistema','Notas'];
  const rows = books.map(b => {
    const s = sec(b.section);
    return [
      b.locationCode||'', b.title||'', b.author||'', b.section||'', s.name,
      b.publisher||'', b.year||'', b.isbn||'', b.language||'',
      b.pages||'', b.coverType||'', b.condition||'',
      b.acquisitionDate ? new Date(b.acquisitionDate).toLocaleDateString('es-CO') : '',
      b.dateAdded ? new Date(b.dateAdded).toLocaleDateString('es-CO') : '',
      b.notes||''
    ].map(v => `"${String(v).replace(/"/g,'""')}"`).join(',');
  });
  const csv = '﻿' + cols.map(c=>`"${c}"`).join(',') + '\n' + rows.join('\n');
  const blob = new Blob([csv], {type:'text/csv;charset=utf-8'});
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  a.href = url; a.download = 'mi-biblioteca.csv'; a.click();
  URL.revokeObjectURL(url);
  toast('Catálogo exportado en CSV.');
}

