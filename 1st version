// ─── Genera el siguiente código de sección disponible ─────────────────────────
function nextAvailSecCode() {
  const used = new Set(getAllSections().map(s => s.code));
  for (let c = 65; c <= 90; c++) {
    const code = String.fromCharCode(c);
    if (!used.has(code)) return code;
  }
  // Si A-Z están todos usados, prueba AA, AB…
  for (let c1 = 65; c1 <= 90; c1++)
    for (let c2 = 65; c2 <= 90; c2++) {
      const code = String.fromCharCode(c1) + String.fromCharCode(c2);
      if (!used.has(code)) return code;
    }
  return 'XX';
}

// ─── Paleta de colores para secciones auto-creadas ────────────────────────────
const AUTO_COLORS = ['#5B4A8B','#3A6B5B','#7A3D1A','#1A5C6B','#6B3A5B','#2D5A2D',
                     '#8B5A1A','#1A3D6B','#5B1A3D','#3D5A1A','#6B1A2D','#1A5B5B'];

// ─── Resuelve el código de sección a partir del valor del Excel ───────────────
function resolveImportSection(rawSec, autoSecMap) {
  if (!rawSec) return 'O';
  const rawUp  = rawSec.toUpperCase().trim();
  const allS   = getAllSections();

  // 1. Código exacto (A, B, … o código personalizado de 2-3 chars)
  let s = allS.find(x => rawUp === x.code);
  if (s) return s.code;

  // 2. Empieza con código + separador ("A - Novela", "A: algo")
  s = allS.find(x => rawUp.startsWith(x.code+' ') || rawUp.startsWith(x.code+'-') ||
                      rawUp.startsWith(x.code+':') || rawUp.startsWith(x.code+'.'));
  if (s) return s.code;

  // 3. Nombre exacto normalizado (sin tildes, sin importar mayúsculas)
  const normRaw  = normStr(rawSec);
  s = allS.find(x => normStr(x.name) === normRaw);
  if (s) return s.code;

  // 4. Nombre exacto "neutro en género" (latinoamericano ≈ latinoamericana)
  const stemRaw = normStem(rawSec);
  s = allS.find(x => normStem(x.name) === stemRaw);
  if (s) return s.code;

  // 5. Contención parcial: el nombre de sección contiene el valor o viceversa
  s = allS.find(x => {
    const nname = normStr(x.name), nraw = normRaw;
    return nname.length > 4 && (nraw.includes(nname) || nname.includes(nraw));
  });
  if (s) return s.code;

  // 6. Contención parcial con normalización neutra
  s = allS.find(x => {
    const sname = normStem(x.name), sraw = stemRaw;
    return sname.length > 4 && (sraw.includes(sname) || sname.includes(sraw));
  });
  if (s) return s.code;

  // 7. Coincidencia por palabras clave compartidas (≥ 2 palabras de >4 letras en común)
  const rawWords = normRaw.split(' ').filter(w => w.length > 4);
  s = allS.find(x => {
    const sWords = normStr(x.name).split(' ').filter(w => w.length > 4);
    return rawWords.filter(w => sWords.includes(w)).length >= 1 && rawWords.length > 0;
  });
  if (s) return s.code;

  // 8. Auto-crear sección personalizada para nombres no reconocidos
  const key = normRaw;
  if (!autoSecMap[key]) {
    const code  = nextAvailSecCode();
    const color = AUTO_COLORS[Object.keys(autoSecMap).length % AUTO_COLORS.length];
    const name  = rawSec.trim();
    const short = name.split(' ').slice(0,2).join(' ');
    DB.addSection({ code, name, short, color });
    DB._s = null; // invalidar caché de secciones
    autoSecMap[key] = code;
  }
  return autoSecMap[key];
}

function confirmImport() {
  const rows = window._importRows;
  const map  = window._importMapping;
  if (!rows || !map) return;

  const autoSecMap = {}; // nombre normalizado → código auto-creado
  let imported = 0, skippedBase = 0, skippedLoc = 0, skippedDate = 0;

  rows.forEach(r => {
    const title  = String(r[map.title]  || '').trim();
    const author = String(r[map.author] || '').trim();
    if (!title || !author) { skippedBase++; return; }

    const shelf = parseInt(r[map.shelf])    || 0;
    const pos   = parseInt(r[map.position]) || 0;
    if (!shelf || !pos) { skippedLoc++; return; }

    const acqDate = String(r[map.acquisitionDate] || '').trim();
    if (!acqDate) { skippedDate++; return; }

    const rawSec  = map.section ? String(r[map.section] || '').trim() : '';
    const section = resolveImportSection(rawSec, autoSecMap);

    DB.addBook({
      title, author, section, shelf, position: pos,
      locationCode: locCode(section, shelf, pos),
      coauthors:       String(r[map.coauthors]  || '').trim(),
      publisher:       String(r[map.publisher]  || '').trim(),
      year:            String(r[map.year]       || '').trim(),
      isbn:            String(r[map.isbn]       || '').trim(),
      language:        String(r[map.language]   || 'Español').trim() || 'Español',
      pages:           String(r[map.pages]      || '').trim(),
      coverType:       String(r[map.coverType]  || 'Pasta blanda').trim(),
      condition:       String(r[map.condition]  || 'Bueno').trim(),
      acquisitionDate: acqDate,
      notes:           String(r[map.notes]      || '').trim(),
      coverImage: '',
    });
    imported++;
  });

  closeImportModal();
  updateSidebarStats();
  const newSecCount = Object.keys(autoSecMap).length;
  const skipped = skippedBase + skippedLoc + skippedDate;
  let msg = `✓ ${imported} libro${imported!==1?'s':''} importado${imported!==1?'s':''}`;
  if (skippedBase)  msg += ` · ${skippedBase} omitido${skippedBase!==1?'s':''} (sin título/autor)`;
  if (skippedLoc)   msg += ` · ${skippedLoc} omitido${skippedLoc!==1?'s':''} (sin ubicación)`;
  if (skippedDate)  msg += ` · ${skippedDate} omitido${skippedDate!==1?'s':''} (sin fecha de ingreso)`;
  if (newSecCount)  msg += ` · ${newSecCount} sección${newSecCount!==1?'es':''} nueva${newSecCount!==1?'s':''} creada${newSecCount!==1?'s':''} automáticamente`;
  toast(msg, 6000);
  navigate('catalog');
}

function downloadTemplate() {
  if (typeof XLSX === 'undefined') {
    // Fallback CSV
    const csv = '﻿Titulo,Autor,Seccion,Estante,Posicion,Fecha ingreso,Editorial,Año,ISBN,Idioma,Paginas,Encuadernacion,Estado,Notas,Coautores\n'
      + '"Cien años de soledad","García Márquez, Gabriel",NC,1,1,2024-03-15,"Editorial Sudamericana",1967,9789584248008,Español,471,"Pasta blanda",Bueno,"Primera edición",""';
    const a = document.createElement('a');
    a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv);
    a.download = 'plantilla-biblioteca.csv'; a.click();
    return;
  }

  const wb = XLSX.utils.book_new();

  // Hoja 1: Datos
  const headers = ['Titulo','Autor','Seccion','Estante','Posicion','Fecha ingreso','Editorial','Año','ISBN','Idioma','Paginas','Encuadernacion','Estado','Notas','Coautores'];
