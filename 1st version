function renderSections() {
  const books     = DB.books();
  const custom    = DB.sections();
  const allSecs   = getAllSections();
  const byS = {};
  books.forEach(b => { byS[b.section] = (byS[b.section]||0)+1; });
  const total = books.length || 1;
  const isCustom  = code => custom.some(s => s.code === code);
  const isDefault = code => SECTIONS.some(s => s.code === code);

  return `
  <div class="view-header">
    <div>
      <div class="view-eyebrow">Organización de la biblioteca</div>
      <h1 class="view-title">Secciones de localización</h1>
    </div>
    <button class="btn btn-primary" onclick="openSectionModal()">+ Nueva sección</button>
  </div>

  <div class="panel" style="margin-bottom:20px;padding:18px 24px">
    <p style="font-size:13px;color:var(--text-muted);line-height:1.7">
      El sistema incluye <strong>45 secciones predefinidas</strong> más las secciones personalizadas que agregues.
      El código de localización tiene el formato <strong class="mono" style="font-size:14px">NC-2-15</strong> = Sección · Estante · Posición.
      Haz clic en una tarjeta para ver sus libros. Las secciones personalizadas se pueden editar o eliminar.
    </p>
  </div>

  <div class="sections-grid">
    ${allSecs.map(s => {
      const count   = byS[s.code]||0;
      const pct     = Math.round(count/total*100);
      const custom  = !isDefault(s.code);
      const actions = custom ? `
        <div class="section-card-actions" onclick="event.stopPropagation()">
          <button class="btn-sec-edit" onclick="openSectionModal('${s.code}')">Editar</button>
          <button class="btn-sec-del"  onclick="deleteCustomSection('${s.code}')">Eliminar</button>
        </div>` : '';
      return `<div class="section-card" onclick="filterBySection('${s.code}')">
        <div class="section-card-top">
          <div class="section-code-big" style="background:${s.color}">${esc(s.code)}</div>
          <div style="flex:1">
            <div class="section-card-name">${esc(s.name)}${custom?'<span class="sec-badge-custom">personalizada</span>':''}</div>
            <div class="section-card-count">${count} libro${count!==1?'s':''}</div>
          </div>
        </div>
        <div class="section-card-bar">
          <div class="section-card-bar-fill" style="width:${Math.max(pct,3)}%;background:${s.color}"></div>
        </div>
        ${actions}
      </div>`;
    }).join('')}
  </div>`;
}

function filterBySection(code) {
  state.filterSection = code;
  navigate('catalog', {keepSearch:true});
}

