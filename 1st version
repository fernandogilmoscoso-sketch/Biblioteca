  }
}

// Normaliza cadena: minúsculas, sin tildes, sin caracteres especiales
function normStr(s) {
  return String(s).toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')   // quita diacríticos (unicode explícito)
    .replace(/[^a-z0-9 ]/g, '').trim();
}

// Normalización "neutral en género": quita terminación -o/-a/-os/-as de palabras > 4 letras
// para que "latinoamericano" y "latinoamericana" sean equivalentes
function normStem(s) {
  return normStr(s).split(' ').map(w => w.length > 4 ? w.replace(/[oa]s?$/, '') : w).join(' ');
}

function detectMapping(headers) {
  const map = {};
  // Pre-normalizar alias una sola vez
  const normAliases = {};
  for (const [field, aliases] of Object.entries(FIELD_ALIASES)) {
    normAliases[field] = aliases.map(normStr);
  }

  // ── PASO 1: solo coincidencias EXACTAS (mayor prioridad, evita conflictos)
  headers.forEach(h => {
    const norm = normStr(h);
    for (const [field] of Object.entries(FIELD_ALIASES)) {
      if (!map[field] && normAliases[field].includes(norm)) map[field] = h;
    }
  });

  // ── PASO 2: coincidencias PARCIALES (solo campos aún sin detectar)
  headers.forEach(h => {
    const norm = normStr(h);
    for (const [field] of Object.entries(FIELD_ALIASES)) {
      if (map[field]) continue;
      const na = normAliases[field];
      // el encabezado contiene un alias de ≥5 chars
      if (na.some(a => a.length >= 5 && norm.includes(a))) { map[field] = h; continue; }
      // un alias contiene el encabezado (ej. "sec" dentro de "seccion")
      if (norm.length >= 4 && na.some(a => a.includes(norm))) { map[field] = h; }
    }
  });

  return map;
}

