// ─────────────────────────────────────────────────────
// APP STATE
// ─────────────────────────────────────────────────────
const state = {
  view: 'dashboard',
  editId: null,
  printId: null,
  search: '',
  filterSection: '',
  filterStatus: '',
  loanTab: 'active',
};

// ─────────────────────────────────────────────────────
// DATABASE (Firebase Firestore)
// ─────────────────────────────────────────────────────
let appState = { userId: null, books: [], loans: [], sections: [] };

const DB = {
  books() { return appState.books; },
  loans() { return appState.loans; },
  activeLoans() { return appState.loans.filter(l => l.status === 'active'); },
  bookLoan(bookId) { return appState.loans.find(l => l.bookId === bookId && l.status === 'active'); },
  sections() { return appState.sections; },

  async syncBooks() {
    if (!appState.userId || !window.firebaseReady) return;
    try {
      const { getDocs, collection, query, where } = window.firebaseReady;
      const db = window.firebaseReady.db;
      const q = query(collection(db, 'books'), where('userId', '==', appState.userId));
      const snap = await getDocs(q);
      appState.books = snap.docs.map(d => ({id: d.id, ...d.data()}));
    } catch(e) { console.error('syncBooks error:', e); }
  },

  async addBook(b) {
    if (!appState.userId || !window.firebaseReady) return;
    b.id = uid(); b.dateAdded = new Date().toISOString(); b.userId = appState.userId;
    const { setDoc, doc } = window.firebaseReady;
    const db = window.firebaseReady.db;
    try {
      await setDoc(doc(db, 'books', b.id), b);
      appState.books.unshift(b);
      return b;
    } catch(e) { console.error('addBook error:', e); }
  },

  async updateBook(id, data) {
    if (!appState.userId || !window.firebaseReady) return;
    const { updateDoc, doc } = window.firebaseReady;
    const db = window.firebaseReady.db;
    try {
      await updateDoc(doc(db, 'books', id), data);
      const i = appState.books.findIndex(x => x.id === id);
      if (i >= 0) appState.books[i] = {...appState.books[i], ...data};
    } catch(e) { console.error('updateBook error:', e); }
  },

  async deleteBook(id) {
    if (!appState.userId || !window.firebaseReady) return;
    const { deleteDoc, doc } = window.firebaseReady;
    const db = window.firebaseReady.db;
    try {
      await deleteDoc(doc(db, 'books', id));
      appState.books = appState.books.filter(x => x.id !== id);
    } catch(e) { console.error('deleteBook error:', e); }
  },

  async syncLoans() {
    if (!appState.userId || !window.firebaseReady) return;
    try {
      const { getDocs, collection, query, where } = window.firebaseReady;
      const db = window.firebaseReady.db;
      const q = query(collection(db, 'loans'), where('userId', '==', appState.userId));
      const snap = await getDocs(q);
      appState.loans = snap.docs.map(d => ({id: d.id, ...d.data()}));
    } catch(e) { console.error('syncLoans error:', e); }
  },

  async addLoan(l) {
    if (!appState.userId || !window.firebaseReady) return;
    l.id = uid(); l.created = new Date().toISOString(); l.userId = appState.userId;
    const { setDoc, doc } = window.firebaseReady;
    const db = window.firebaseReady.db;
    try {
      await setDoc(doc(db, 'loans', l.id), l);
      appState.loans.unshift(l);
      return l;
    } catch(e) { console.error('addLoan error:', e); }
  },

  async updateLoan(id, data) {
    if (!appState.userId || !window.firebaseReady) return;
    const { updateDoc, doc } = window.firebaseReady;
    const db = window.firebaseReady.db;
    try {
      await updateDoc(doc(db, 'loans', id), data);
      const i = appState.loans.findIndex(x => x.id === id);
      if (i >= 0) appState.loans[i] = {...appState.loans[i], ...data};
    } catch(e) { console.error('updateLoan error:', e); }
  },

  async syncSections() {
    if (!appState.userId || !window.firebaseReady) return;
    try {
      const { getDocs, collection, query, where } = window.firebaseReady;
      const db = window.firebaseReady.db;
      const q = query(collection(db, 'sections'), where('userId', '==', appState.userId));
      const snap = await getDocs(q);
      appState.sections = snap.docs.map(d => ({code: d.id, ...d.data()}));
    } catch(e) { console.error('syncSections error:', e); }
  },

  async addSection(s) {
    if (!appState.userId || !window.firebaseReady) return;
    s.userId = appState.userId;
    const { setDoc, doc } = window.firebaseReady;
    const db = window.firebaseReady.db;
    try {
      await setDoc(doc(db, 'sections', s.code), s);
      appState.sections.push(s);
    } catch(e) { console.error('addSection error:', e); }
  },

  async updateSection(code, data) {
    if (!appState.userId || !window.firebaseReady) return;
    const { updateDoc, doc } = window.firebaseReady;
    const db = window.firebaseReady.db;
    try {
      await updateDoc(doc(db, 'sections', code), data);
      const i = appState.sections.findIndex(x => x.code === code);
      if (i >= 0) appState.sections[i] = {...appState.sections[i], ...data};
    } catch(e) { console.error('updateSection error:', e); }
  },

  async deleteSection(code) {
    if (!appState.userId || !window.firebaseReady) return;
    const { deleteDoc, doc } = window.firebaseReady;
    const db = window.firebaseReady.db;
    try {
      await deleteDoc(doc(db, 'sections', code));
      appState.sections = appState.sections.filter(x => x.code !== code);
    } catch(e) { console.error('deleteSection error:', e); }
  },
};

// ─────────────────────────────────────────────────────
// UTILITIES
// ─────────────────────────────────────────────────────
function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2,7); }

function fmtDate(s) {
  if (!s) return '—';
  return new Date(s).toLocaleDateString('es-CO', {day:'2-digit',month:'2-digit',year:'numeric'});
}

function toInputDate(s) {
  if (!s) return '';
  return new Date(s).toISOString().slice(0,10);
}

// Merges the 15 built-in sections with any user-created custom sections
function getAllSections() { return [...SECTIONS, ...DB.sections()]; }

function sec(code) { return getAllSections().find(s => s.code === code) || {code,name:'Desconocido',color:'#666',short:code}; }

function isOverdue(loan) {
  return loan.status === 'active' && loan.expectedReturn && new Date(loan.expectedReturn) < new Date();
}

function locCode(section, shelf, pos) {
  if (!section) return '';
  return `${section}-${String(shelf||'?')}-${String(pos||'??').padStart(2,'0')}`;
}

function esc(s) {
  if (s == null) return '';
  return String(s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function toast(msg, dur=2800) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), dur);
}

function updateSidebarStats() {
  const al = DB.activeLoans();
  const od = al.filter(isOverdue);
  const el = id => document.getElementById(id);
  if (el('sb-total')) el('sb-total').textContent = DB.books().length;
  if (el('sb-loans')) el('sb-loans').textContent = al.length;
  if (el('sb-overdue')) el('sb-overdue').textContent = od.length;
}

// ─────────────────────────────────────────────────────
// NAVIGATION
// ─────────────────────────────────────────────────────
function navigate(view, params = {}) {
  state.view = view;
  state.editId = params.editId || null;
  state.printId = params.printId || null;
  if (!params.keepSearch) { state.search = ''; state.filterSection = ''; state.filterStatus = ''; }
  document.querySelectorAll('.nav-item').forEach(el =>
    el.classList.toggle('active', el.dataset.view === view));
  renderView();
  updateSidebarStats();
  if (params.openAIScan) setTimeout(() => openAIScanModal(), 120);
}

function renderView() {
  const mc = document.getElementById('main-content');
  const renders = {
    dashboard: renderDashboard,
    catalog:   renderCatalog,
    register:  renderRegister,
    loans:     renderLoans,
    sections:  renderSections,
    print:     renderPrintView,
  };
  mc.innerHTML = (renders[state.view] || renderDashboard)();
  mc.scrollTop = 0;
  if (state.view === 'catalog')  setupCatalogEvents();
  if (state.view === 'register') setupRegisterEvents();
}

