      ? `<div class="empty-state"><div class="empty-icon"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/></svg></div><p>No hay préstamos activos. ¡Todos los libros están en casa.</p></div>`
      : active.map(l => {
          const b = DB.books().find(x=>x.id===l.bookId);
          const ov = isOverdue(l);
          const daysRemaining = l.expectedReturn
            ? Math.round((new Date(l.expectedReturn)-new Date())/(86400000))
            : null;
          return `<div class="loan-card${ov?' overdue':''}">
            <div class="loan-card-header">
              <div>
                <div class="loan-book-title">${b?esc(b.title):'(libro eliminado)'}</div>
                <div class="loan-book-author">${b?esc(b.author||''):''}${b?.locationCode?` · <span class="mono" style="font-size:11px">${b.locationCode}</span>`:''}</div>
              </div>
              <span class="badge ${ov?'badge-overdue':'badge-loan'}">${ov?'Vencido':'Activo'}</span>
            </div>
            <div class="loan-card-body">
              <div class="loan-info-block"><div class="loan-info-label">Prestado a</div><div class="loan-info-val">${esc(l.borrowerName)}</div></div>
              <div class="loan-info-block"><div class="loan-info-label">Teléfono</div><div class="loan-info-val mono">${esc(l.borrowerPhone||'—')}</div></div>
              <div class="loan-info-block">
                <div class="loan-info-label">Devolución esperada</div>
                <div class="loan-info-val ${ov?'text-danger':''}">${fmtDate(l.expectedReturn)}</div>
                ${daysRemaining!==null?`<div style="font-size:11px;color:${ov?'var(--danger)':'var(--text-muted)'}">${ov?`Vencido hace ${-daysRemaining} días`:`Faltan ${daysRemaining} días`}</div>`:''}
              </div>
            </div>
            <div class="loan-card-foot">
              <button class="btn btn-secondary btn-sm" onclick="returnLoan('${l.id}')">✓ Marcar como devuelto</button>
              ${l.notes?`<span style="font-size:12px;color:var(--text-muted);align-self:center">Nota: ${esc(l.notes)}</span>`:''}
            </div>
          </div>`;
        }).join('')
  ) : (
    !history.length
      ? `<div class="empty-state"><p>Sin historial de préstamos aún.</p></div>`
      : `<div class="panel"><div class="table-wrap"><table class="data-table">
          <thead><tr><th>Libro</th><th>Prestado a</th><th>Teléfono</th><th>Fecha préstamo</th><th>Devuelto</th></tr></thead>
          <tbody>
            ${history.map(l => {
              const b = DB.books().find(x=>x.id===l.bookId);
              return `<tr>
                <td>${b?esc(b.title):'(eliminado)'}</td>
                <td>${esc(l.borrowerName)}</td>
                <td class="mono">${esc(l.borrowerPhone||'—')}</td>
                <td>${fmtDate(l.created)}</td>
                <td>${fmtDate(l.returnDate)}</td>
              </tr>`;
            }).join('')}
          </tbody>
        </table></div></div>`
  )}`;
}

function switchLoanTab(tab) { state.loanTab = tab; renderView(); }

function openLoanModal(bookId) {
  const b = DB.books().find(x=>x.id===bookId);
  if (!b) return;
  const modal = document.getElementById('loan-modal');
  const body  = document.getElementById('loan-modal-body');
  const today = new Date();
  const defReturn = new Date(today.getTime() + 30*86400000).toISOString().slice(0,10);

  body.innerHTML = `
    <p style="font-size:13px;margin-bottom:14px;color:var(--text-muted)">Registrando préstamo de <strong style="color:var(--text)">${esc(b.title)}</strong></p>
    <div style="display:flex;flex-direction:column;gap:12px">
      <div class="form-field">
        <label class="form-label">Nombre completo <span class="req">*</span></label>
        <input id="ln-name" class="form-input" placeholder="Nombre del prestatario">
      </div>
      <div class="form-field">
        <label class="form-label">Teléfono / WhatsApp</label>
        <input id="ln-phone" class="form-input" placeholder="ej. 3001234567" type="tel">
      </div>
      <div class="form-field">
        <label class="form-label">Fecha de devolución esperada</label>
        <input id="ln-return" class="form-input" type="date" value="${defReturn}">
      </div>
      <div class="form-field">
        <label class="form-label">Notas</label>
        <input id="ln-notes" class="form-input" placeholder="Observaciones opcionales">
      </div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeLoanModal()">Cancelar</button>
      <button class="btn btn-primary" onclick="confirmLoan('${bookId}')">Registrar préstamo</button>
    </div>`;
  modal.style.display = 'flex';
}

function closeLoanModal() { document.getElementById('loan-modal').style.display = 'none'; }

function confirmLoan(bookId) {
  const name = document.getElementById('ln-name')?.value.trim();
  if (!name) { toast('El nombre es obligatorio.'); return; }
  DB.addLoan({
    bookId, borrowerName: name,
    borrowerPhone: document.getElementById('ln-phone')?.value.trim() || '',
    expectedReturn: document.getElementById('ln-return')?.value || '',
    notes: document.getElementById('ln-notes')?.value.trim() || '',
    status: 'active',
  });
  closeLoanModal();
  toast(`Préstamo de "${DB.books().find(b=>b.id===bookId)?.title||'libro'}" registrado.`);
  updateSidebarStats();
  renderView();
}

function returnLoan(loanId) {
  if (!confirm('¿Confirmar devolución del libro?')) return;
  DB.updateLoan(loanId, { status:'returned', returnDate: new Date().toISOString() });
  toast('Devolución registrada.');
  updateSidebarStats();
  renderView();
}

function returnBookFromCatalog(bookId) {
  const loan = DB.bookLoan(bookId);
  if (loan) returnLoan(loan.id);
}

