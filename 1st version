function setupAIDropZone() {
  const dz  = document.getElementById('ai-drop-zone');
  const inp = document.getElementById('ai-file-input');
  if (!dz || !inp) return;

  inp.addEventListener('change', () => { if (inp.files[0]) loadAIImage(inp.files[0]); });
  dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('drag-over'); });
  dz.addEventListener('dragleave', () => dz.classList.remove('drag-over'));
  dz.addEventListener('drop', e => {
    e.preventDefault(); dz.classList.remove('drag-over');
    const f = e.dataTransfer.files[0];
    if (f && f.type.startsWith('image/')) loadAIImage(f);
  });
}

function loadAIImage(file) {
  if (file.size > 5*1024*1024) { toast('La imagen debe pesar menos de 5 MB.'); return; }
  const reader = new FileReader();
  reader.onload = e => {
    const dataUrl = e.target.result;
    const mimeType = file.type || 'image/jpeg';
    const base64 = dataUrl.split(',')[1];
    _aiScanImage = { base64, mimeType, dataUrl };
    const dz = document.getElementById('ai-drop-zone');
    if (dz) {
      dz.innerHTML = `<img src="${dataUrl}" style="max-height:200px;max-width:100%;border-radius:6px;object-fit:contain">
        <div style="font-size:11px;color:var(--text-muted);margin-top:8px">${esc(file.name)} · ${(file.size/1024).toFixed(0)} KB — haz clic para cambiar</div>`;
    }
  };
  reader.readAsDataURL(file);
}

async function doAIScan() {
  const keyInput = document.getElementById('ai-api-key');
  const apiKey = (keyInput?.value || '').trim();
  if (!apiKey) { toast('Ingresa tu clave API de Anthropic.'); keyInput?.focus(); return; }
  if (!_aiScanImage) { toast('Sube una foto del libro primero.'); return; }

  localStorage.setItem('bib_ai_key', apiKey);

  // Saber qué campos pedir
  const fieldMap = [
    ['ai-f-title',   'title',     'titulo'],
    ['ai-f-author',  'author',    'autor'],
    ['ai-f-publisher','publisher','editorial'],
    ['ai-f-year',    'year',      'anio'],
    ['ai-f-lang',    'language',  'idioma'],
    ['ai-f-cover',   'coverType', 'encuadernacion'],
    ['ai-f-cond',    'condition', 'estado'],
    ['ai-f-acq',     'acqDate',   'fecha_ingreso'],
  ];
  const selected = fieldMap.filter(([chkId]) => document.getElementById(chkId)?.checked);
  const wantsAcq = selected.some(f => f[1] === 'acqDate');

  // Spinner
  document.getElementById('ai-scan-body').innerHTML = `
    <div class="ai-spinner">
      <div class="ai-spinner-ring"></div>
      <div style="font-size:14px;color:var(--text-muted)">Analizando imagen con Claude AI…</div>
      <div style="font-size:12px;color:var(--text-muted)">Esto tarda unos segundos</div>
    </div>`;

  const camposJson = selected
    .filter(f => f[1] !== 'acqDate')
    .map(([,,k]) => `  "${k}": "…"`)
    .join(',\n');

  const prompt =
`Analiza la imagen de este libro y extrae la información que sea visible.
Responde ÚNICAMENTE con un objeto JSON válido, sin texto adicional, sin bloques de código markdown.

Devuelve exactamente este esquema (usa null si el campo no es visible o no puedes determinarlo):
{
${camposJson}
}

Reglas estrictas:
- encuadernacion: usa exactamente uno de → "Pasta blanda", "Pasta dura", "Otro"
- estado: usa exactamente uno de → "Excelente", "Bueno", "Regular", "Deteriorado" (evalúa el desgaste físico visible)
- anio: solo 4 dígitos numéricos, sin texto adicional
- autor: formato "Apellido, Nombre" si es posible identificarlo
- Si no ves el valor con claridad, usa null`;

  try {
    const resp = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': apiKey,
        'anthropic-version': '2023-06-01',
        'anthropic-dangerous-direct-browser-access': 'true',
      },
      body: JSON.stringify({
        model: 'claude-opus-4-5',
        max_tokens: 600,
        messages: [{
          role: 'user',
          content: [
            { type: 'image', source: { type: 'base64', media_type: _aiScanImage.mimeType, data: _aiScanImage.base64 } },
            { type: 'text',  text: prompt }
          ]
        }]
      })
    });

    if (!resp.ok) {
      const err = await resp.json().catch(() => ({}));
      throw new Error(err.error?.message || `Error HTTP ${resp.status}`);
    }

    const data = await resp.json();
    const raw  = data.content?.[0]?.text || '';

    // Extraer JSON de la respuesta
    let parsed = {};
    try {
      const match = raw.match(/\{[\s\S]*\}/);
      parsed = match ? JSON.parse(match[0]) : {};
    } catch { parsed = {}; }

    // Inyectar fecha de ingreso = hoy si fue solicitada
    if (wantsAcq) parsed.fecha_ingreso = new Date().toISOString().slice(0, 10);

    renderAIScanResults(parsed, selected);

  } catch (err) {
    document.getElementById('ai-scan-body').innerHTML = `
      <div style="background:var(--danger-dim);color:var(--danger);border-radius:6px;padding:14px 16px;margin-bottom:16px;font-size:13px;line-height:1.6">
        <strong>Error al conectar con Claude AI</strong><br>${esc(err.message)}
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button class="btn btn-ghost" onclick="closeAIScanModal()">Cerrar</button>
        <button class="btn-ai-scan" onclick="openAIScanModal()">Reintentar</button>
      </div>`;
  }
}

function renderAIScanResults(parsed, selected) {
  const labels = {
    titulo:'Título', autor:'Autor principal', editorial:'Editorial',
    anio:'Año publicación', idioma:'Idioma', encuadernacion:'Encuadernación',
    estado:'Estado de conservación', fecha_ingreso:'Fecha de ingreso',
  };
  const keyOrder = ['titulo','autor','editorial','anio','idioma','encuadernacion','estado','fecha_ingreso'];
  const fields = keyOrder.filter(k => k in parsed);

  const html = fields.map(k => {
    const val = parsed[k];
    return `<div class="ai-result-field">
      <div class="ai-result-label">${labels[k]||k}</div>
      <div class="ai-result-value ${val===null||val===undefined?'ai-null':''}">${val!==null&&val!==undefined?esc(String(val)):'No detectado'}</div>
    </div>`;
  }).join('');

  document.getElementById('ai-scan-body').innerHTML = `
    <div style="font-size:13px;font-weight:600;margin-bottom:12px;color:var(--text)">
      ✓ Análisis completado — revisa los campos antes de aplicar:
    </div>
    <div class="ai-result-grid">${html}</div>
    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:18px">
      <button class="btn btn-ghost" onclick="openAIScanModal()">← Escanear otra foto</button>
      <button class="btn btn-ghost" onclick="closeAIScanModal()">Cancelar</button>
      <button class="btn-ai-scan" onclick="applyAIScanResults(${esc(JSON.stringify(parsed))})">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Cargar en formulario
      </button>
    </div>`;
}

function applyAIScanResults(parsed) {
  // Mapeo de clave JSON → id del campo del formulario
  const setVal = (id, val) => {
    if (!val) return;
    const el = document.getElementById(id);
    if (!el) return;
    if (el.tagName === 'SELECT') {
      // Busca la option más parecida
      const norm = String(val).toLowerCase().trim();
      const opt = [...el.options].find(o => o.value.toLowerCase() === norm || o.text.toLowerCase() === norm);
      if (opt) el.value = opt.value;
    } else {
      el.value = val;
    }
  };

  if (parsed.titulo)         setVal('f-title',    parsed.titulo);
  if (parsed.autor)          setVal('f-author',   parsed.autor);
  if (parsed.editorial)      setVal('f-publisher',parsed.editorial);
  if (parsed.anio)           setVal('f-year',     parsed.anio);
  if (parsed.idioma)         setVal('f-lang',     parsed.idioma);
  if (parsed.encuadernacion) setVal('f-cover',    parsed.encuadernacion);
  if (parsed.estado)         setVal('f-cond',     parsed.estado);
  if (parsed.fecha_ingreso)  setVal('f-acq-date', parsed.fecha_ingreso);

  closeAIScanModal();
  toast('✓ Campos cargados desde el análisis de IA. Revisa y completa los que falten.');
}

