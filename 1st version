      Registrar libro
    </button>
  </div>

  ${od.length ? `<div class="alert alert-warning">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><circle cx="12" cy="16" r=".5" fill="currentColor"/></svg>
    <span><strong>${od.length} préstamo${od.length>1?'s':''}</strong> con devolución vencida.</span>
    <button class="btn btn-sm btn-secondary" onclick="navigate('loans')">Ver préstamos</button>
  </div>` : ''}

  <div class="stat-grid">
    <div class="stat-card"><div class="stat-label">Total libros</div><div class="stat-value">${books.length.toLocaleString('es-CO')}</div><div class="stat-sub">registrados</div></div>
    <div class="stat-card"><div class="stat-label">Secciones activas</div><div class="stat-value">${Object.keys(byS).length}</div><div class="stat-sub">de 15 disponibles</div></div>
    <div class="stat-card"><div class="stat-label">En préstamo</div><div class="stat-value ${al.length?'stat-warn':''}">${al.length}</div><div class="stat-sub">${od.length?`<span style="color:var(--danger)">${od.length} vencidos</span>`:'al día'}</div></div>
    <div class="stat-card"><div class="stat-label">Préstamos históricos</div><div class="stat-value">${loans.length}</div><div class="stat-sub">total registrados</div></div>
  </div>

  <div class="two-col">
    <div class="panel">
      <div class="panel-header"><h2 class="panel-title">Últimos ingresos</h2><button class="btn btn-ghost btn-sm" onclick="navigate('catalog')">Ver todos</button></div>
      ${!recent.length ? `<div class="empty-state-small">Sin libros. <button class="link-btn" onclick="navigate('register')">Registra el primero.</button></div>` :
        recent.map(b => {
          const s = sec(b.section), loan = DB.bookLoan(b.id);
          return `<div class="mini-book-row">
            <div class="mini-section-badge" style="background:${s.color}">${s.code}</div>
            <div class="mini-book-info"><div class="mini-book-title">${esc(b.title)}</div><div class="mini-book-author">${esc(b.author||'—')}</div></div>
            <div class="mini-book-meta">${loan?'<span class="badge badge-loan">Prestado</span>':''}<span class="location-code">${esc(b.locationCode||'')}</span></div>
          </div>`;
        }).join('')}
    </div>

    <div class="panel">
      <div class="panel-header"><h2 class="panel-title">Por sección</h2><button class="btn btn-ghost btn-sm" onclick="navigate('sections')">Ver mapa</button></div>
      ${!topS.length ? `<div class="empty-state-small">Registra libros para ver estadísticas.</div>` :
        topS.map(s => {
          const pct = books.length ? Math.round(s.count/books.length*100) : 0;
          return `<div class="section-stat-row">
            <div class="section-badge" style="background:${s.color}">${s.code}</div>
            <div class="section-stat-info"><div class="section-stat-name">${s.name}</div><div class="section-stat-bar-wrap"><div class="section-stat-bar" style="width:${pct}%;background:${s.color}"></div></div></div>
            <div class="section-stat-count">${s.count}</div>
          </div>`;
        }).join('')}
    </div>
  </div>

  ${al.length ? `<div class="panel">
    <div class="panel-header"><h2 class="panel-title">Préstamos activos</h2><button class="btn btn-ghost btn-sm" onclick="navigate('loans')">Gestionar</button></div>
    <div class="table-wrap"><table class="data-table">
      <thead><tr><th>Libro</th><th>Prestado a</th><th>Teléfono</th><th>Devolución esperada</th><th>Estado</th><th></th></tr></thead>
      <tbody>
        ${al.map(l => {
          const b = DB.books().find(x=>x.id===l.bookId);
          const ov = isOverdue(l);
          return `<tr>
            <td>${b?esc(b.title):'(eliminado)'}</td>
            <td>${esc(l.borrowerName)}</td>
            <td class="mono">${esc(l.borrowerPhone||'—')}</td>
            <td class="${ov?'text-danger':''}">${fmtDate(l.expectedReturn)}</td>
            <td><span class="badge ${ov?'badge-overdue':'badge-loan'}">${ov?'Vencido':'Activo'}</span></td>
            <td><button class="btn btn-sm btn-secondary" onclick="returnLoan('${l.id}')">Devuelto</button></td>
          </tr>`;
        }).join('')}
      </tbody>
    </table></div>
  </div>` : ''}`;
}

// ─────────────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────────────
function renderCatalog() {
  const all = DB.books();
  const loanedIds = new Set(DB.activeLoans().map(l=>l.bookId));
  let books = all;
  if (state.search) {
    const q = state.search.toLowerCase();
    books = books.filter(b =>
      b.title?.toLowerCase().includes(q) ||
      b.author?.toLowerCase().includes(q) ||
      b.isbn?.includes(q) ||
      b.publisher?.toLowerCase().includes(q) ||
      b.locationCode?.toLowerCase().includes(q)
    );
  }
  if (state.filterSection) books = books.filter(b => b.section === state.filterSection);
  if (state.filterStatus === 'loan') books = books.filter(b => loanedIds.has(b.id));
  if (state.filterStatus === 'available') books = books.filter(b => !loanedIds.has(b.id));

  return `
  <div class="view-header">
    <div>
      <div class="view-eyebrow">Colección completa</div>
      <h1 class="view-title">Catálogo <span class="count-badge">${books.length}</span></h1>
    </div>
    <div class="header-actions">
      <button class="btn btn-secondary" onclick="openImportModal()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Importar Excel
      </button>
      <button class="btn btn-secondary" onclick="exportXLSX()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 15 12 10 17 15"/><line x1="12" y1="10" x2="12" y2="21"/></svg>
        Exportar Excel
      </button>
      <button class="btn btn-secondary" onclick="saveBackup()" title="Guardar copia de seguridad completa (libros, préstamos, secciones)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
        Guardar
      </button>
      <button class="btn btn-primary" onclick="navigate('register')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Registrar libro
      </button>
    </div>
