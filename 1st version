// ─────────────────────────────────────────────────────
// SECTION MANAGEMENT
// ─────────────────────────────────────────────────────
let _secEditCode = null; // null = create mode, string = edit mode

function openSectionModal(editCode) {
  _secEditCode = editCode || null;
  const modal = document.getElementById('sec-modal');
  const titleEl = document.getElementById('sec-modal-title');
  const codeInp = document.getElementById('sec-code');
  const nameInp = document.getElementById('sec-name');
  const shortInp = document.getElementById('sec-short');
  const colorInp = document.getElementById('sec-color');
  const hexInp   = document.getElementById('sec-color-hex');
  const errEl    = document.getElementById('sec-error');

  errEl.style.display = 'none';

  if (editCode) {
    const s = getAllSections().find(x => x.code === editCode);
    titleEl.textContent = 'Editar sección';
    codeInp.value  = s.code;
    codeInp.disabled = true; // code is the primary key — don't allow change
    nameInp.value  = s.name;
    shortInp.value = s.short || '';
    colorInp.value = s.color;
    hexInp.value   = s.color;
  } else {
    titleEl.textContent = 'Nueva sección';
    codeInp.value  = '';
    codeInp.disabled = false;
    nameInp.value  = '';
    shortInp.value = '';
    colorInp.value = '#2D5A8E';
    hexInp.value   = '#2D5A8E';
  }
  previewSectionCard();
  modal.style.display = 'flex';
  setTimeout(() => (editCode ? nameInp : codeInp).focus(), 80);
}

function closeSectionModal() {
  document.getElementById('sec-modal').style.display = 'none';
  _secEditCode = null;
}

function syncColorHex(val) {
  if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
    document.getElementById('sec-color').value = val;
    previewSectionCard();
  }
}

function previewSectionCard() {
  const code  = (document.getElementById('sec-code').value || 'P').toUpperCase();
  const name  = document.getElementById('sec-name').value || 'Nueva sección';
  const color = document.getElementById('sec-color').value || '#2D5A8E';
  document.getElementById('sec-color-hex').value = color;
  document.getElementById('sec-prev-code').textContent = code;
  document.getElementById('sec-prev-code').style.background = color;
  document.getElementById('sec-prev-name').textContent = name;
  document.getElementById('sec-prev-bar').style.background = color;
}

function saveSectionModal() {
  const code  = document.getElementById('sec-code').value.trim().toUpperCase();
  const name  = document.getElementById('sec-name').value.trim();
  const short = document.getElementById('sec-short').value.trim() || name.split(' ').slice(0,2).join(' ');
  const color = document.getElementById('sec-color').value;
  const errEl = document.getElementById('sec-error');

  // Validation
  if (!code || !/^[A-Z0-9]{1,3}$/.test(code)) {
    showSecError('El código debe tener 1–3 letras o números (sin espacios ni tildes).'); return;
  }
  if (!name) {
    showSecError('El nombre de la sección es obligatorio.'); return;
  }

  if (_secEditCode) {
    // Edit mode — update the custom section
    DB.updateSection(_secEditCode, { name, short, color });
    toast(`Sección ${_secEditCode} actualizada.`);
  } else {
    // Create mode — check code is unique
    if (getAllSections().some(s => s.code === code)) {
      showSecError(`El código "${code}" ya está en uso. Elige uno diferente.`); return;
    }
    DB.addSection({ code, name, short, color });
    toast(`Sección ${code} — ${name} creada correctamente.`);
  }

  closeSectionModal();
  updateSidebarStats();
  renderView();
}

function showSecError(msg) {
  const el = document.getElementById('sec-error');
  el.textContent = msg;
  el.style.display = 'block';
}

function deleteCustomSection(code) {
  // Safety: don't delete a default section
  if (SECTIONS.some(s => s.code === code)) {
    toast('Las secciones predefinidas no se pueden eliminar.'); return;
  }
  const s = DB.sections().find(x => x.code === code);
  if (!s) return;

  const booksInSec = DB.books().filter(b => b.section === code).length;
  const warning = booksInSec > 0
    ? `\n\nAtención: hay ${booksInSec} libro${booksInSec!==1?'s':''} en esta sección. Quedarán asignados a "O — Varios" si continúas.`
    : '';

  if (!confirm(`¿Eliminar la sección "${code} — ${s.name}"?${warning}`)) return;

  // Re-assign affected books to 'O'
  if (booksInSec > 0) {
    DB.books().filter(b => b.section === code).forEach(b => {
      DB.updateBook(b.id, { section: 'OT', locationCode: locCode('OT', b.shelf, b.position) });
    });
  }

  DB.deleteSection(code);
  toast(`Sección ${code} eliminada.`);
  updateSidebarStats();
  renderView();
}

// ─────────────────────────────────────────────────────
// BULK SELECT & DELETE
// ─────────────────────────────────────────────────────
function getSelectedIds() {
  return [...document.querySelectorAll('.book-chk:checked')].map(el => el.dataset.id);
}

function toggleSelectAll(checked) {
  document.querySelectorAll('.book-chk').forEach(el => el.checked = checked);
  updateBulkBar();
}

function updateBulkBar() {
  const ids = getSelectedIds();
  const bar = document.getElementById('bulk-bar');
  const cnt = document.getElementById('bulk-count');
  if (bar) bar.classList.toggle('hidden', ids.length === 0);
  if (cnt) {
    const n = ids.length;
    cnt.textContent = `${n} libro${n !== 1 ? 's' : ''} seleccionado${n !== 1 ? 's' : ''}`;
  }
  // Update master checkbox state
  const all = document.querySelectorAll('.book-chk');
  const chkAll = document.getElementById('chk-all');
  if (chkAll) {
    chkAll.checked = ids.length === all.length && all.length > 0;
    chkAll.indeterminate = ids.length > 0 && ids.length < all.length;
  }
}

function clearSelection() {
  document.querySelectorAll('.book-chk').forEach(el => el.checked = false);
  const chkAll = document.getElementById('chk-all');
  if (chkAll) { chkAll.checked = false; chkAll.indeterminate = false; }
  updateBulkBar();
}

function openBulkDeleteModal() {
  const ids = getSelectedIds();
  if (ids.length === 0) return;
  const books = DB.books();
  const selected = ids.map(id => books.find(b => b.id === id)).filter(Boolean);

  // Populate count label
  const n = selected.length;
  document.getElementById('bdm-count').textContent =
    `${n} libro${n !== 1 ? 's' : ''}`;

  // Populate book list
  const listEl = document.getElementById('bdm-list');
  listEl.innerHTML = selected.map(b => {
    const loc = [b.section, b.shelf, b.position].filter(Boolean).join('-');
    return `<div style="padding:4px 0;border-bottom:1px solid var(--border);display:flex;gap:8px;align-items:baseline">
      <span style="font-weight:600;flex:1">${esc(b.title)}</span>
      <span style="color:var(--text-muted);font-size:12px;white-space:nowrap">${esc(b.author||'')}${loc?' · '+loc:''}</span>
    </div>`;
  }).join('') + (selected.length === 0 ? '<em>Sin libros seleccionados</em>' : '');

  // Reset confirmation input
  const inp = document.getElementById('bdm-confirm-input');
  const btn = document.getElementById('bdm-confirm-btn');
  inp.value = '';
  btn.disabled = true;
  btn.style.opacity = '.45';
  btn.style.cursor = 'not-allowed';

  document.getElementById('bulk-del-modal').style.display = 'flex';
}

function closeBulkDeleteModal() {
  document.getElementById('bulk-del-modal').style.display = 'none';
}

function validateBulkConfirm() {
  const inp = document.getElementById('bdm-confirm-input');
  const btn = document.getElementById('bdm-confirm-btn');
  const ok = inp.value.trim().toUpperCase() === 'ELIMINAR';
  btn.disabled = !ok;
  btn.style.opacity = ok ? '1' : '.45';
  btn.style.cursor = ok ? 'pointer' : 'not-allowed';
}

function confirmBulkDelete() {
  const inp = document.getElementById('bdm-confirm-input');
  if (inp.value.trim().toUpperCase() !== 'ELIMINAR') return;

  const ids = getSelectedIds();
  if (ids.length === 0) return;

  // Cancel any active loans for these books
  const loans = DB.loans();
  ids.forEach(id => {
    const loan = DB.bookLoan(id);
    if (loan) DB.updateLoan(loan.id, { status: 'cancelled' });
  });

  // Delete each book
  ids.forEach(id => DB.deleteBook(id));

  closeBulkDeleteModal();
  clearSelection();

  const n = ids.length;
  toast(`${n} libro${n !== 1 ? 's' : ''} eliminado${n !== 1 ? 's' : ''} correctamente.`);
  updateSidebarStats();
  renderView();
}

